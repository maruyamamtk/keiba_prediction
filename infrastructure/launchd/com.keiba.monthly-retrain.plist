<?xml version="1.0" encoding="UTF-8"?>
<!--
  ローカル月次モデル再学習 launchd 定義

  毎週月曜 AM1:00 に scripts/monthly_retrain_local.sh を起動する。
  スクリプト側の「第1月曜ガード」により、月内最初の月曜だけ実処理する
  （＝実質「毎月第1月曜 AM1:00」）。

  導入手順:
    1. __PROJECT_ROOT__ を実際の絶対パス（例: /Users/xxx/Desktop/keiba_prediction）に置換
       する。もしくは sed で自動置換する:
         sed "s#__PROJECT_ROOT__#$(pwd)#g" infrastructure/launchd/com.keiba.monthly-retrain.plist \
           > ~/Library/LaunchAgents/com.keiba.monthly-retrain.plist
    2. 登録:  launchctl load ~/Library/LaunchAgents/com.keiba.monthly-retrain.plist
    3. 確認:  launchctl list | grep com.keiba.monthly-retrain
    解除:     launchctl unload ~/Library/LaunchAgents/com.keiba.monthly-retrain.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.keiba.monthly-retrain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/monthly_retrain_local.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <!-- 毎週月曜 AM1:00（第1月曜ガードでスクリプトが月初のみ実処理） -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/launchd_monthly_retrain.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/launchd_monthly_retrain.err.log</string>
</dict>
</plist>
