# Dockerfile.dashboard
# Streamlit ダッシュボード用コンテナ（dashboard-service Cloud Run）
FROM python:3.13-slim

WORKDIR /app

# システム依存パッケージ（LightGBM 読み込みのみ必要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 依存パッケージをインストール（Playwright は不要）
RUN pip install --no-cache-dir \
    google-cloud-bigquery==3.27.0 \
    google-cloud-storage==2.19.0 \
    db-dtypes==1.4.2 \
    pandas==2.2.3 \
    numpy==2.2.3 \
    lightgbm==4.6.0 \
    streamlit==1.44.1 \
    plotly==6.0.1 \
    python-dotenv==1.1.0 \
    PyYAML==6.0.2

# アプリケーションコードをコピー
COPY src/ ./src/
COPY config/ ./config/

# 環境変数
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

# Streamlit を起動（ヘッドレス・ポート指定）
CMD ["streamlit", "run", "src/dashboard/app.py", \
     "--server.port=8080", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]
